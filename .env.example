# ============================================================
# ATTENDLY – Biến môi trường cho Docker Compose
# ============================================================
# Copy file này thành .env và cập nhật giá trị phù hợp:
#   cp .env.example .env        (Linux/Mac)
#   Copy-Item .env.example .env (PowerShell)
# ============================================================

# ── MySQL ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=attendance_system
# Cổng MySQL map ra máy host (mặc định 3306)
DB_EXTERNAL_PORT=3306

# ── Application ────────────────────────────────────────────
# Cổng Express server map ra máy host
PORT=5000

# URL frontend (để cấu hình CORS). Bỏ trống = cho phép mọi origin.
# Production ví dụ: https://attendly.example.com
CLIENT_URL=

# ── Security ───────────────────────────────────────────────
# BẮT BUỘC đổi trong production! Tạo secret bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-doi-secret-nay-trong-production-toi-thieu-32-ky-tu

# ── Face Recognition ───────────────────────────────────────
FACE_MATCH_THRESHOLD=0.6
