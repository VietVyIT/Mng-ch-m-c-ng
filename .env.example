# -------------------------------------------------------------------
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy tệp này thành .env và điền các giá trị thực tế
# -------------------------------------------------------------------

# 1. DATABASE CONFIGURATION
# Mật khẩu root của MySQL (Bảo mật: Nên dùng chuỗi ngẫu nhiên dài, ít nhất 16 ký tự)
DB_ROOT_PASSWORD=your_secure_mysql_root_password_here
# Tên cơ sở dữ liệu
DB_NAME=attendance_system

# 2. APPLICATION CONFIGURATION
# Khóa bí mật dùng cho JWT (JSON Web Tokens). Phải giữ bí mật tuyệt đối.
# Lệnh tạo ngẫu nhiên trên Linux: openssl rand -hex 32
ADMIN_SECRET_KEY=your_secure_jwt_secret_key_here

# 3. EMAIL SERVICE CONFIGURATION (Nodemailer)
# Tài khoản email dùng để gửi thông báo/OTP
EMAIL_USER=your_email@gmail.com
# Mật khẩu ứng dụng (App Password) của Gmail, không phải mật khẩu tài khoản
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# 4. DOMAIN CONFIGURATION
# Tên miền chính của hệ thống (VD: attendly.vn)
DOMAIN_NAME=yourdomain.com
