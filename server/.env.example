NODE_ENV=development
PORT=5000

# Local frontend origin. In Railway, replace with the deployed Vercel URL.
CLIENT_URL=http://localhost:5173

# Local MySQL values. Railway can use MYSQLHOST/MYSQLPORT/MYSQLDATABASE/
# MYSQLUSER/MYSQLPASSWORD injected by the linked MySQL service instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_system
DB_USER=root
DB_PASSWORD=

# Never commit a real secret. Generate a production value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FACE_MATCH_THRESHOLD=0.6
